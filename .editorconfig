# Editor settings (#71). The Objective-C code is formatted by clang-format
# (.clang-format, Tools/format.sh); these keep other files and editors in line.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

# Markdown ends a line with two spaces for a line break.
[*.md]
trim_trailing_whitespace = false

# Binary or generated by Xcode/Interface Builder: left as they are.
[*.{nib,icns,png,tiff,pbxproj}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
